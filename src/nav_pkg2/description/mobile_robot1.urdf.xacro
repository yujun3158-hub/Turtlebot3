<?xml version="1.0"?>

<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro"
    name="mobile_robot1">

    <!-- ====================================================== -->
    <!-- 기본 크기 파라미터 -->
    <!-- ====================================================== -->

    <xacro:property name="body_length" value="0.35"/>
    <xacro:property name="body_width"  value="0.28"/>
    <xacro:property name="body_height" value="0.10"/>

    <xacro:property name="wheel_radius" value="0.07"/>
    <xacro:property name="wheel_width"  value="0.04"/>

    <!-- 좌우 바퀴 중심 사이 거리 -->
    <xacro:property name="wheel_separation" value="0.32"/>


    <!-- ====================================================== -->
    <!-- 1. base_footprint -->
    <!-- ====================================================== -->

    <!--
        바닥 기준 좌표계

        실제 형상은 없고 TF 기준용으로 사용한다.
    -->

    <link name="base_footprint"/>


    <!-- ====================================================== -->
    <!-- 2. base_link -->
    <!-- ====================================================== -->

    <link name="base_link">

        <!-- ======== Visual ======== -->

        <visual>

            <geometry>
                <box size="
                    ${body_length}
                    ${body_width}
                    ${body_height}
                "/>
            </geometry>

            <material name="blue">
                <color rgba="0.15 0.35 0.8 1.0"/>
            </material>

        </visual>


        <!-- ======== Collision ======== -->

        <collision>

            <geometry>
                <box size="
                    ${body_length}
                    ${body_width}
                    ${body_height}
                "/>
            </geometry>

        </collision>


        <!-- ======== Inertia ======== -->

        <inertial>

            <mass value="3.0"/>

            <inertia
                ixx="0.0221"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0331"
                iyz="0.0"
                izz="0.0502"/>

        </inertial>

    </link>


    <!--
        base_footprint → base_link

        바퀴 반지름이 0.07m이고
        본체 중심은 바닥에서 0.12m 위에 둔다.
    -->

    <joint
        name="base_footprint_joint"
        type="fixed">

        <parent link="base_footprint"/>
        <child link="base_link"/>

        <origin
            xyz="0 0 0.12"
            rpy="0 0 0"/>

    </joint>


    <!-- ====================================================== -->
    <!-- 3. Left Wheel -->
    <!-- ====================================================== -->

    <link name="left_wheel_link">

        <visual>

            <origin
                xyz="0 0 0"
                rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

            <material name="black">
                <color rgba="0.05 0.05 0.05 1.0"/>
            </material>

        </visual>


        <collision>

            <origin
                xyz="0 0 0"
                rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

        </collision>


        <inertial>

            <mass value="0.4"/>

            <inertia
                ixx="0.00054"
                ixy="0"
                ixz="0"
                iyy="0.00098"
                iyz="0"
                izz="0.00054"/>

        </inertial>

    </link>


    <joint
        name="left_wheel_joint"
        type="continuous">

        <parent link="base_link"/>
        <child link="left_wheel_link"/>

        <!--
            base_link의 높이가 0.12
            wheel center는 바닥에서 0.07

            따라서:
            0.07 - 0.12 = -0.05
        -->

        <origin
            xyz="0.05 0.16 -0.05"
            rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- ====================================================== -->
    <!-- 4. Right Wheel -->
    <!-- ====================================================== -->

    <link name="right_wheel_link">

        <visual>

            <origin
                xyz="0 0 0"
                rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

            <material name="black"/>

        </visual>


        <collision>

            <origin
                xyz="0 0 0"
                rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

        </collision>


        <inertial>

            <mass value="0.4"/>

            <inertia
                ixx="0.00054"
                ixy="0"
                ixz="0"
                iyy="0.00098"
                iyz="0"
                izz="0.00054"/>

        </inertial>

    </link>


    <joint
        name="right_wheel_joint"
        type="continuous">

        <parent link="base_link"/>
        <child link="right_wheel_link"/>

        <origin
            xyz="0.05 -0.16 -0.05"
            rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- ====================================================== -->
    <!-- 5. Caster -->
    <!-- ====================================================== -->

    <!--
        실제 caster를 매우 단순화해서
        마찰이 작은 구 형태로 표현한다.
    -->

    <link name="caster_link">

        <visual>

            <geometry>
                <sphere radius="0.035"/>
            </geometry>

            <material name="gray">
                <color rgba="0.4 0.4 0.4 1.0"/>
            </material>

        </visual>


        <collision>

            <geometry>
                <sphere radius="0.035"/>
            </geometry>

        </collision>


        <inertial>

            <mass value="0.15"/>

            <inertia
                ixx="0.0000735"
                ixy="0"
                ixz="0"
                iyy="0.0000735"
                iyz="0"
                izz="0.0000735"/>

        </inertial>

    </link>


    <joint
        name="caster_joint"
        type="fixed">

        <parent link="base_link"/>
        <child link="caster_link"/>

        <origin
            xyz="-0.14 0 -0.085"
            rpy="0 0 0"/>

    </joint>


    <!-- ====================================================== -->
    <!-- 6. LiDAR -->
    <!-- ====================================================== -->

    <link name="base_scan">

        <visual>

            <geometry>
                <cylinder
                    radius="0.04"
                    length="0.05"/>
            </geometry>

            <material name="red">
                <color rgba="0.8 0.1 0.1 1.0"/>
            </material>

        </visual>


        <collision>

            <geometry>
                <cylinder
                    radius="0.04"
                    length="0.05"/>
            </geometry>

        </collision>


        <inertial>

            <mass value="0.15"/>

            <inertia
                ixx="0.000091"
                ixy="0"
                ixz="0"
                iyy="0.000091"
                iyz="0"
                izz="0.00012"/>

        </inertial>

    </link>


    <joint
        name="base_scan_joint"
        type="fixed">

        <parent link="base_link"/>
        <child link="base_scan"/>

        <origin
            xyz="0.08 0 0.13"
            rpy="0 0 0"/>

    </joint>


    <!-- ====================================================== -->
    <!-- Gazebo Material / Friction -->
    <!-- ====================================================== -->

    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
    </gazebo>


    <gazebo reference="left_wheel_link">

        <material>Gazebo/Black</material>

        <mu1>1.0</mu1>
        <mu2>1.0</mu2>

    </gazebo>


    <gazebo reference="right_wheel_link">

        <material>Gazebo/Black</material>

        <mu1>1.0</mu1>
        <mu2>1.0</mu2>

    </gazebo>


    <!--
        caster는 회전 joint까지 만들지 않고
        작은 마찰값으로 쉽게 미끄러지게 한다.
    -->

    <gazebo reference="caster_link">

        <material>Gazebo/Grey</material>

        <mu1>0.01</mu1>
        <mu2>0.01</mu2>

    </gazebo>


    <!-- ====================================================== -->
    <!-- 7. Differential Drive Plugin -->
    <!-- ====================================================== -->

    <gazebo>

        <plugin
            name="diff_drive"
            filename="libgazebo_ros_diff_drive.so">

            <update_rate>50</update_rate>


            <!-- 사용되는 바퀴 joint -->

            <left_joint>
                left_wheel_joint
            </left_joint>

            <right_joint>
                right_wheel_joint
            </right_joint>


            <!-- 로봇 기구학 -->

            <wheel_separation>
                ${wheel_separation}
            </wheel_separation>

            <wheel_diameter>
                ${wheel_radius * 2.0}
            </wheel_diameter>


            <!-- 모터 제한 -->

            <max_wheel_torque>
                20.0
            </max_wheel_torque>

            <max_wheel_acceleration>
                0.5
            </max_wheel_acceleration>


            <!-- ROS Topic -->

            <command_topic>
                cmd_vel
            </command_topic>

            <odometry_topic>
                odom
            </odometry_topic>


            <!-- Odometry -->

            <publish_odom>
                true
            </publish_odom>

            <publish_odom_tf>
                true
            </publish_odom_tf>

            <publish_wheel_tf>
                true
            </publish_wheel_tf>


            <!-- TF -->

            <odometry_frame>
                odom
            </odometry_frame>

            <robot_base_frame>
                base_footprint
            </robot_base_frame>

        </plugin>

    </gazebo>


    <!-- ====================================================== -->
    <!-- 8. LiDAR Gazebo Plugin -->
    <!-- ====================================================== -->

    <gazebo reference="base_scan">

        <sensor
            name="lidar_sensor"
            type="ray">

            <always_on>true</always_on>

            <!-- Gazebo에서 laser 선 표시 -->
            <visualize>true</visualize>

            <update_rate>10</update_rate>


            <ray>

                <scan>

                    <horizontal>

                        <samples>360</samples>

                        <resolution>
                            1.0
                        </resolution>

                        <min_angle>
                            -3.14159
                        </min_angle>

                        <max_angle>
                            3.14159
                        </max_angle>

                    </horizontal>

                </scan>


                <range>

                    <min>0.12</min>

                    <max>8.0</max>

                    <resolution>
                        0.01
                    </resolution>

                </range>


                <noise>

                    <type>
                        gaussian
                    </type>

                    <mean>
                        0.0
                    </mean>

                    <stddev>
                        0.005
                    </stddev>

                </noise>

            </ray>


            <plugin
                name="laser_plugin"
                filename="libgazebo_ros_ray_sensor.so">

                <ros>

                    <remapping>
                        ~/out:=scan
                    </remapping>

                </ros>


                <output_type>
                    sensor_msgs/LaserScan
                </output_type>

                <frame_name>
                    base_scan
                </frame_name>

            </plugin>

        </sensor>

    </gazebo>


</robot>